# Primary AI (OpenAI-compatible)
AI_API_KEY=your-primary-ai-key
AI_BASE_URL=https://cdn.12ai.org/v1
AI_MODEL=claude-sonnet-4-5-20250929

# Fallback AI (optional)
AI_FALLBACK_API_KEY=your-fallback-ai-key
AI_FALLBACK_BASE_URL=https://api.deepseek.com/v1
AI_FALLBACK_MODEL=deepseek-chat

# OCR (vision) dedicated config (recommended)
# Many chat-only models (e.g. deepseek-chat) do NOT support image_url vision inputs.
# If you use screenshots OCR, set AI_OCR_* to a vision-capable model/provider.
AI_OCR_API_KEY=
AI_OCR_BASE_URL=
AI_OCR_MODEL=
AI_OCR_FALLBACK_API_KEY=
AI_OCR_FALLBACK_BASE_URL=
AI_OCR_FALLBACK_MODEL=

# Growth mode (optional)
NEXT_PUBLIC_GROWTH_MODE=false
GROWTH_MODE=false

# Rate limit (optional, in-memory, best-effort)
RL_OCR_CHAT_LIMIT=16
RL_OCR_CHAT_WINDOW_MS=60000
RL_OCR_LIMIT=20
RL_OCR_WINDOW_MS=60000
RL_ANALYSIS_LIMIT=12
RL_ANALYSIS_WINDOW_MS=60000
RL_FORTUNE_LIMIT=16
RL_FORTUNE_WINDOW_MS=60000
RL_LAUNDERER_LIMIT=10
RL_LAUNDERER_WINDOW_MS=60000
RL_MARKETING_PACK_LIMIT=8
RL_MARKETING_PACK_WINDOW_MS=60000
RL_LEAD_LIMIT=20
RL_LEAD_WINDOW_MS=60000
RL_UNLOCK_LIMIT=30
RL_UNLOCK_WINDOW_MS=60000
RL_ADMIN_SESSION_LIMIT=20
RL_ADMIN_SESSION_WINDOW_MS=60000

# Paywall
# PAYWALL_SECRET is required for signed unlock codes like: ORDER_ID.SIGNATURE (e.g. SLXXXX...a1b2c3d4e5)
PAYWALL_SECRET=change_me_to_a_long_random_string

# Optional: legacy static unlock codes. If omitted, users must use signed unlock codes (recommended).
UNLOCK_CODE_SOUL=
UNLOCK_CODE_FORTUNE_TAROT=
UNLOCK_CODE_FORTUNE_DAILY=
UNLOCK_CODE_LAUNDERER=

# Internal admin pages (/marketing /growth /overview)
ADMIN_DASH_PASSWORD=change_me_strong_password

# PostHog (optional)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
